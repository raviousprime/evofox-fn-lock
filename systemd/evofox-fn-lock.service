[Unit]
Description=EvoFox Fn Lock Userspace Input Daemon
Documentation=https://github.com/custom/evofox-fn-lock
After=multi-user.target
Wants=systemd-udev-settle.service

[Service]
Type=simple
User=root
Group=root

# Executable invocation (supports both venv and system python)
ExecStart=/opt/evofox-fn-lock/venv/bin/python /opt/evofox-fn-lock/src/daemon.py --config /etc/evofox-fn-lock/config.toml
Restart=always
RestartSec=3

# Clean shutdown
KillMode=process
TimeoutStopSec=5

# Security hardening and sandboxing
ProtectSystem=full
ProtectHome=true
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
DevicePolicy=closed

# Logging to systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

